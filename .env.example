MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
NEXT_PUBLIC_GEOAPIFY_API_KEY=your_geoapify_api_key
NEXT_PUBLIC_API_BASE=
MONGODB_TLS_INSECURE=0
MONGODB_DB=allremotes
AWS_ACCESS_KEY_ID=your_aws_access_key_id
S3_BUCKET_URL=https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=ap-southeast-2
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----your_apple_private_key-----END PRIVATE KEY-----
APPLE_KEY_ID=your_apple_key_id
APPLE_TEAM_ID=your_apple_team_id
NEXT_PUBLIC_APPLE_SERVICE_ID=your.apple.service.id
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Email Configuration (Outlook / Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@yourdomain.com
SMTP_PASS=your_smtp_password
EMAIL_FROM=noreply@yourdomain.com

# Site URL (for email links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ClickSend SMS Configuration
CLICKSEND_USERNAME=your_clicksend_username
CLICKSEND_API_KEY=your_clicksend_api_key
# Sender ID - what customers see when receiving SMS:
#   1. Alphanumeric name: AllRemotes (max 11 chars, customers CANNOT reply)
#   2. Dedicated number: +614XXXXXXXX (customers CAN reply - get from ClickSend)
#   3. Shared number: Leave empty (uses ClickSend shared number, CAN reply)
CLICKSEND_FROM=AllRemotes


